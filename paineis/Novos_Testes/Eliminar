// Conexão
$conn = mysqli_connect("localhost", "usuario", "senha", "seu_banco");

// Query para contar consultas por mês no ano atual
$query = "SELECT 
            MONTH(data_consulta) as mes, 
            COUNT(*) as total 
          FROM consultas 
          WHERE YEAR(data_consulta) = YEAR(CURDATE()) 
          GROUP BY MONTH(data_consulta) 
          ORDER BY MONTH(data_consulta) ASC";

$result = mysqli_query($conn, $query);

// Inicializa um array com 12 posições zeradas (Jan a Dez)
$dados_meses = array_fill(1, 12, 0);

// Preenche o array com os resultados do banco
while ($row = mysqli_fetch_assoc($result)) {
    $dados_meses[(int)$row['mes']] = (int)$row['total'];
}

// Converte para formato que o JavaScript entende (separado por vírgula)
$valores_grafico = implode(',', $dados_meses);
?>




