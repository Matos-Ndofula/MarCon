2. Configuração do Gráfico Mensal (JavaScript)
Troquei os dias da semana pelos meses e ajustei a configuração para que a linha fique mais suave (tension).
javascript
const ctx = document.getElementById('graficoMensal').getContext('2d');

new Chart(ctx, {
    type: 'line',
    data: {
        // Rótulos para os meses
        labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
        datasets: [
            {
                label: 'Agendadas',
                data: [65, 59, 80, 81, 56, 55, 40, 70, 90, 100, 110, 120],
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                fill: true,
                tension: 0.4
            },
            {
                label: 'Atendidas',
                data: [28, 48, 40, 19, 86, 27, 90, 60, 80, 85, 95, 105],
                borderColor: '#198754',
                tension: 0.4
            },
            {
                label: 'Desmarcadas',
                data: [5, 10, 5, 2, 20, 15, 10, 8, 12, 5, 10, 8],
                borderColor: '#dc3545',
                borderDash: [5, 5], // Linha pontilhada para desmarcadas
                tension: 0.4
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'bottom' }
        },
        scales: {
            y: {
                beginAtZero: true,
                grid: { color: '#f0f0f0' }
            },
            x: {
                grid: { display: false }
            }
        }
    }
});
