$conexao = mysqli_connect("localhost", "usuario", "senha", "nome_banco");

if (isset($_POST['confirmar_eliminar'])) {
    // Escapa a string para evitar SQL Injection
    $id = mysqli_real_escape_string($conexao, $_POST['id_medico']);

    $sql = "DELETE FROM medicos WHERE id = '$id'";

    if (mysqli_query($conexao, $sql)) {
        header("Location: lista_medicos.php?msg=sucesso");
    } else {
        echo "Erro ao eliminar: " . mysqli_error($conexao);
    }
}

mysqli_close($conexao);
