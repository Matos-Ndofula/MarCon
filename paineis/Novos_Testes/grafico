                <?php echo $status_counts['Cancelada']; ?>
            ],
            backgroundColor: ['#4caf50', '#2196f3', '#f44336']
        }]
    },
    options: {
        plugins: {
            legend: { position: 'right' }
        }
    }
});
</script>

